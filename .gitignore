# ---- Segredos: NUNCA devem ir para o GitHub ----
# Chave do banco, JWT_SECRET e RESEND_API_KEY ficam aqui. Em produção, eles
# são cadastrados no painel do Render (Environment), não no repositório.
.env
.env.*
!env.example
!.env.example
 
# ---- Dependências (o Render instala sozinho com o package.json) ----
node_modules/
.pnp.*
 
# ---- Logs e relatórios ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
 
# ---- Arquivos de teste e rascunhos locais ----
coverage/
*.tmp
*.bak
*.zip
shots/
scratch/
rascunho*/
 
# ---- Banco local e dumps (podem conter dados de usuários) ----
*.sqlite
*.sqlite3
*.db
*.dump
backup*.sql
 
# ---- Sistema operacional e editores ----
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
