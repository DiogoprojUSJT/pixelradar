# Copie este arquivo para ".env" e preencha com os seus valores reais.
# Nunca envie o arquivo ".env" (com valores reais) para o GitHub.

# String de conexao do banco Postgres (Neon, Supabase, Render, etc.)
DATABASE_URL=postgresql://usuario:senha@host:5432/banco?sslmode=require

# Texto secreto usado para assinar os tokens de login. Troque por um valor
# longo e aleatorio, por exemplo gerado com: openssl rand -hex 32
JWT_SECRET=troque-por-um-valor-aleatorio-bem-grande

# Dominio(s) que podem chamar a API. Use "*" em testes, e o dominio real
# do seu site (ex: https://meusite.netlify.app) em producao.
CORS_ORIGEM=*

# Porta em que a API vai rodar localmente (a maioria dos serviços de
# hospedagem gratuita define isso sozinha e ignora este valor).
PORT=3000
